                 ALOGE("%s: Camera %d: Waiting to stop streaming failed: %s (%d)",
@@ -1995,12 +1990,8 @@ status_t Camera2Client::createJpegStreamL(Parameters &params) {
         return res;
     }
 
-    res = mDevice->flush();
