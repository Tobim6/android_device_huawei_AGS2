diff --git a/libs/ui/Gralloc2.cpp b/libs/ui/Gralloc2.cpp
index 918251f..b25569e 100644
--- a/libs/ui/Gralloc2.cpp
+++ b/libs/ui/Gralloc2.cpp
@@ -95,10 +95,12 @@ Gralloc2::Error Mapper::validateBufferDescriptorInfo(
         validUsageBits = validUsageBits | getValid11UsageBits();
     }
 
+    // AGS2: the Huawei camera HAL requests streams with vendor-private gralloc usage bits
